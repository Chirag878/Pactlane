# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Public origin override. Leave unset unless a custom domain needs it.
# BETTER_AUTH_URL=

# Database. Unset in local development means PGlite at data/pglite.
# Production: the Supabase transaction pooler (port 6543).
# DATABASE_URL=
# Production migrations only: a Supabase direct or session-pooler URL. Read by
# `pnpm migrate:production`; do not set it on the Worker.
# DATABASE_URL_UNPOOLED=

# Required on Cloudflare Workers so the scheduled sweep can authenticate.
# A2A_SECRET=

# Agent model provider. Set one, or connect a provider in the app.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
